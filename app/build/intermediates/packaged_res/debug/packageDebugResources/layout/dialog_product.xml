<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="12dp"
            android:text="Tambah produk"
            android:textColor="#1B2335"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText android:id="@+id/productName" style="@style/DialogField" android:hint="Nama produk" />
        <EditText android:id="@+id/productDescription" style="@style/DialogField" android:gravity="top" android:hint="Deskripsi" android:minLines="2" />
        <TextView android:id="@+id/productCategory" style="@style/DialogField" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:text="Kategori: Food" />
        <EditText android:id="@+id/productPrice" style="@style/DialogField" android:hint="Harga (Rp)" android:inputType="number" />
        <EditText android:id="@+id/productStock" style="@style/DialogField" android:hint="Stok (kosongkan jika tidak dibatasi)" android:inputType="number" />
        <EditText android:id="@+id/productIngredients" style="@style/DialogField" android:gravity="top" android:hint="Bahan / ingredients (opsional)" android:minLines="2" />
        <TextView android:id="@+id/productImage" style="@style/DialogField" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:text="Pilih gambar produk" />
        <Button android:id="@+id/productSave" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:text="Simpan produk" />
        <Button android:id="@+id/productDelete" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="4dp" android:text="Hapus produk" android:visibility="gone" />
    </LinearLayout>
</ScrollView>
