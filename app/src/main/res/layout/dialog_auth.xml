<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="@drawable/bg_dialog">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="20dp">

    <TextView
        android:id="@+id/authTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#1B2335"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/authSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#707889"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/authName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:autofillHints="name"
        android:background="@drawable/bg_field"
        android:hint="Nama asli (cth. Budi Santoso)"
        android:imeOptions="actionNext"
        android:inputType="textPersonName"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:singleLine="true"
        android:textColor="#1B2335"
        android:textColorHint="#707889"
        android:textSize="15sp"
        android:visibility="gone" />

    <EditText
        android:id="@+id/authNis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_field"
        android:hint="NIS / Nomor Induk Siswa (cth. 11111)"
        android:imeOptions="actionNext"
        android:inputType="number"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:singleLine="true"
        android:textColor="#1B2335"
        android:textColorHint="#707889"
        android:textSize="15sp" />

    <EditText
        android:id="@+id/authAutoName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_field"
        android:clickable="false"
        android:cursorVisible="false"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:hint="Nama lengkap (terisi otomatis dari NIS)"
        android:inputType="none"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:singleLine="true"
        android:textColor="#1B2335"
        android:textColorHint="#8A94A6"
        android:textSize="14.5sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/authAutoClass"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_field"
        android:clickable="false"
        android:cursorVisible="false"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:hint="Kelas (terisi otomatis dari NIS)"
        android:inputType="none"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:singleLine="true"
        android:textColor="#0063D6"
        android:textColorHint="#8A94A6"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/authNisStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:text="Ketik NIS untuk mengisi Nama &amp; Kelas secara otomatis."
        android:textColor="#707889"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/authPhone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:autofillHints="phone"
        android:background="@drawable/bg_field"
        android:hint="Nomor HP (cth. 0812xxxxxxx)"
        android:imeOptions="actionNext"
        android:inputType="phone"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:singleLine="true"
        android:textColor="#1B2335"
        android:textColorHint="#707889"
        android:textSize="15sp"
        android:visibility="gone" />

    <EditText
        android:id="@+id/authEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:autofillHints="email"
        android:background="@drawable/bg_field"
        android:hint="Email"
        android:imeOptions="actionNext"
        android:inputType="textEmailAddress"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:singleLine="true"
        android:textColor="#1B2335"
        android:textColorHint="#707889"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_field"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <EditText
            android:id="@+id/authPassword"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:autofillHints="password"
            android:background="@null"
            android:hint="Kata sandi"
            android:imeOptions="actionGo"
            android:inputType="textPassword"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:singleLine="true"
            android:textColor="#1B2335"
            android:textColorHint="#707889"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/authShowPass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="Lihat"
            android:textColor="#0063D6"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/authForgot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:paddingStart="6dp"
        android:paddingEnd="2dp"
        android:text="Lupa kata sandi?"
        android:textColor="#0063D6"
        android:textSize="12.5sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/authError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_error"
        android:padding="12dp"
        android:textColor="#CE3C3C"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/authAction"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_button"
            android:paddingTop="15dp"
            android:paddingBottom="15dp"
            android:stateListAnimator="@null"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/authProgress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:indeterminateTint="#0063D6"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/authToggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:padding="6dp"
        android:textColor="#0063D6"
        android:textSize="13sp"
        android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
